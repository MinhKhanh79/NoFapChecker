<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow/Blur effect using multiple circles -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF" /> <!-- Outer faint glow -->
            <size android:width="18dp" android:height="18dp" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent_red" /> <!-- Actual Dot -->
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
</layer-list>
